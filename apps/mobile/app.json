{
  "expo": {
    "name": "Tappet",
    "slug": "tappet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tappet",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.southmoordigital.tappet",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Tappet uses the camera so you can photograph a service invoice and have its line items read for you.",
