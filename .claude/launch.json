{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "crewchief-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "crewchief-dev-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "autoPort": true
    },
    {
      "name": "crewchief-prod-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:verify",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "crewchief-design",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:design"
      ],
      "autoPort": true
    },
    {
      "name": "expo-mobile",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start"
      ],
      "cwd": "apps/mobile",
      "port": 8081
    },
    {
      "name": "expo-mobile-fixtures",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_DESIGN_FIXTURES=1",
        "npx",
        "expo",
        "start"
      ],
      "cwd": "apps/mobile",
      "port": 8081
    }
  ]
}
